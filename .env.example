# Build-box configuration for remote SSH builds.
# Copy this file to .env and customize as needed.
# .env is gitignored and will not be committed.

# SSH host alias (as configured in ~/.ssh/config) or user@host
# Example: CLAWQ_BUILD_BOX_HOST=x-alpha
CLAWQ_BUILD_BOX_HOST=

# Remote source directory (where the repo will be synced to)
# Example: CLAWQ_BUILD_BOX_REMOTE_DIR=~/src/clawq
CLAWQ_BUILD_BOX_REMOTE_DIR=
